DOMAIN=yourdomain.com
# DB_PASSWORD: bat buoc dat manh cho SQL Server, neu khong container db se crash-loop.
# Yeu cau: >= 8 ky tu VA du 3/4 nhom (chu HOA, chu thuong, so, ky tu dac biet).
# Tranh ky tu ; $ " ' va dau cach (de vo chuoi ket noi / bi shell hieu nham).
DB_PASSWORD=YourStr0ngP@ssword!
JWT_SECRET=YourProductionSecretKeyAtLeast32Characters!

# VietQR
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# SePay (webhook xac nhan chuyen khoan tu dong)
# API Key tu dat trong dashboard SePay (My > Cong ty > Cau hinh Webhooks).
# SePay gui kem header: Authorization: Apikey <SEPAY_API_KEY>
SEPAY_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq (chatbot AI) - thieu key thi chatbot chay che do "bao tri"
GROQ_API_KEY=
